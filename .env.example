POSTGRES_DB=dispatch_intelligence
POSTGRES_USER=dispatch
POSTGRES_PASSWORD=dispatch
POSTGRES_PORT=5432
API_PORT=8000
WEB_PORT=3000
DATABASE_URL=postgresql+psycopg://dispatch:dispatch@db:5432/dispatch_intelligence
VITE_API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:5173
IMPORT_UPLOAD_DIR=./import_uploads
IMPORT_WORKER_POLL_SECONDS=1
ML_ARTIFACT_DIR=./ml_artifacts
# Required before saving a Google Routes API key. Use a strong random value;
# never commit a production value.
GOOGLE_ROUTES_ENCRYPTION_KEY=
# Durable Phase 6 worker: heartbeat must be shorter than the lease.
PHASE6_WORKER_POLL_SECONDS=1
PHASE6_WORKER_HEARTBEAT_SECONDS=5
PHASE6_WORKER_LEASE_SECONDS=30
PHASE6_PREDICTION_TIMEOUT_SECONDS=3600
PHASE6_PREDICTION_MAX_ATTEMPTS=3
# Per-process guardrail for one AMT Scheduler bearer client. Use an API gateway
# for a shared distributed limit when running more than one API replica.
PHASE10_RATE_LIMIT_PER_MINUTE=600
PHASE10_DEFAULT_TIMEZONE=Asia/Jakarta
